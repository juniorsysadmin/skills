#!/bin/sh
# Wrapper for the aws-pricing helper (see ../SKILL.md).
#
# Builds aws_pricing.bin from aws_pricing.go when the binary is missing or
# older than the source, then execs it. Requires only the Go toolchain; the
# first build fetches the AWS SDK modules.
set -eu

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bin="$dir/aws_pricing.bin"

if [ ! -x "$bin" ] || [ "$dir/aws_pricing.go" -nt "$bin" ] || [ "$dir/go.mod" -nt "$bin" ]; then
    echo "aws_pricing: building aws_pricing.bin from aws_pricing.go..." >&2
    (cd "$dir" && go build -ldflags "-s -w" -o aws_pricing.bin .)
fi

exec "$bin" "$@"
